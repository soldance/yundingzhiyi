# 统一行尾为 LF，避免跨平台协作时产生无意义的整文件差异
* text=auto eol=lf

# 明确二进制文件，防止被当作文本处理
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.onnx binary
*.db   binary
*.xlsx binary
*.zip  binary

# 在 GitHub 上不计入语言统计
data/**        linguist-vendored
*.json         linguist-detectable=false

# 合并冲突时把这两类视为二进制，避免自动合并破坏结构
package-lock.json binary
pnpm-lock.yaml    binary
